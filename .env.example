# Copy to .env and adjust. Every variable is optional; defaults are shown.

# ---------------------------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------------------------
# fake      = deterministic offline model (no API key, reproducible; used by tests and the demo)
# openai    = OpenAI via langchain-openai          (needs OPENAI_API_KEY)
# anthropic = Anthropic Claude via langchain-anthropic (needs ANTHROPIC_API_KEY)
# openrouter = any model on openrouter.ai through its OpenAI-compatible API (needs OPENROUTER_API_KEY)
LLM_PROVIDER=fake

OPENAI_MODEL=gpt-5-mini
# OPENAI_API_KEY=sk-...

ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=sk-ant-...

# "vendor/model" ids from https://openrouter.ai/models, e.g. anthropic/claude-sonnet-5, google/gemini-3.5-flash
OPENROUTER_MODEL=openai/gpt-5.4-mini
# OPENROUTER_API_KEY=sk-or-...
# Any OpenAI-compatible gateway works here too (LiteLLM proxy, vLLM, a corporate gateway).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Max output tokens per LLM call (includes reasoning/thinking tokens on models that use them).
LLM_MAX_TOKENS=8192
# Per-request timeout in seconds (the SDK retries twice on transient errors).
LLM_TIMEOUT_SECONDS=90
# Max tool-calling rounds in the research loop before the rules run anyway.
MAX_RESEARCH_STEPS=4

# ---------------------------------------------------------------------------------------------
# Knowledge-base retrieval (help-center articles are embedded and searched by vector similarity)
# ---------------------------------------------------------------------------------------------
# fake   = deterministic hashing embeddings (offline, shared-vocabulary similarity; tests and demo)
# openai = OpenAI embeddings API (needs OPENAI_API_KEY). Anthropic has no embeddings API, so this
#          is independent of LLM_PROVIDER: Claude can write the replies while OpenAI powers retrieval.
# openrouter = embedding models on OpenRouter (needs OPENROUTER_API_KEY)
EMBEDDINGS_PROVIDER=fake
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
OPENROUTER_EMBEDDINGS_MODEL=openai/text-embedding-3-small
# Vector size (text-embedding-3 models can be shortened; pgvector's HNSW index allows up to 2000).
EMBEDDINGS_DIMENSIONS=1536
# memory   = in-process vector index, rebuilt at startup (zero infrastructure)
# pgvector = vectors stored in the Postgres DATABASE_URL (needs the `vector` extension), synced
#            incrementally at startup: only new or edited articles are embedded again.
KB_BACKEND=memory

# ---------------------------------------------------------------------------------------------
# Persistence: tickets, audit trail and LangGraph checkpoints share one database
# ---------------------------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/support_agent.db
# Postgres (install with `uv sync --extra postgres`):
# DATABASE_URL=postgresql+psycopg://support:support@localhost:5432/support

# ---------------------------------------------------------------------------------------------
# Store API (orders, customers, knowledge base, escalations)
# ---------------------------------------------------------------------------------------------
# Empty = bundled mock Store API, called in-process over HTTP (ASGI transport).
# Set to a base URL to call a separately deployed Store API with the same contract.
STORE_API_URL=
STORE_API_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------------------------
# Business rules (see README > Business rules)
# ---------------------------------------------------------------------------------------------
# Refunds are allowed up to and including this many days after delivery.
POLICY_REFUND_WINDOW_DAYS=30
# Refunds up to and including this amount are executed without a human.
POLICY_AUTO_APPROVE_REFUND_LIMIT=100.00
# Refunds for VIP customers always go to a human.
POLICY_VIP_REFUNDS_REQUIRE_APPROVAL=true
# Refund requests written in an angry/hostile tone go to a human.
POLICY_NEGATIVE_SENTIMENT_REQUIRES_APPROVAL=true
# Refunds/address changes from a sender the helpdesk could not verify go to a human.
POLICY_UNVERIFIED_SENDER_REQUIRES_APPROVAL=true
# Complaints with negative sentiment or high urgency are escalated to the human queue.
POLICY_ESCALATE_NEGATIVE_COMPLAINTS=true
# Minimum knowledge-base relevance (cosine similarity) to answer a question automatically, else
# escalate. Tuned for the fake embeddings; real embedding models score unrelated text higher, so
# raise it for them and calibrate with the eval suite (KB hit rate and the unanswerable cases).
# text-embedding-3-small: 0.45 (answerable questions scored 0.49+, unanswerable ones 0.41 at most).
POLICY_KB_MIN_SCORE=0.15

# ---------------------------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------------------------
# Name used in prompts and reply signatures.
STORE_NAME=Brewline Coffee
# Folder with demo tickets (used by the CLI and the UI example picker).
EXAMPLES_DIR=examples
LOG_LEVEL=INFO
# console (human-readable) or json (one JSON object per line, for log aggregation)
LOG_FORMAT=console

# ---------------------------------------------------------------------------------------------
# Tracing
# ---------------------------------------------------------------------------------------------
# OpenTelemetry spans per ticket run, graph node, LLM call and tool call. Off by default.
# none | console (print spans to stdout) | otlp (needs `uv sync --extra tracing`)
OTEL_TRACES_EXPORTER=none
OTEL_SERVICE_NAME=support-autopilot
# Read by the OTLP exporter itself, e.g. a local Jaeger or an OpenTelemetry Collector:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# LangSmith is configured by LangChain from the process environment (not from this file when
# running with plain `uv run`): export these, use `uv run --env-file .env ...`, or rely on
# docker compose, which passes .env into the container.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=support-autopilot
