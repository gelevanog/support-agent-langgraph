# Copy to .env and adjust. Every variable is optional; defaults are shown.

# ---------------------------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------------------------
# fake      = deterministic offline model (no API key, reproducible; used by tests and the demo)
# openai    = OpenAI via langchain-openai          (needs OPENAI_API_KEY)
# anthropic = Anthropic Claude via langchain-anthropic (needs ANTHROPIC_API_KEY)
LLM_PROVIDER=fake

OPENAI_MODEL=gpt-5-mini
# OPENAI_API_KEY=sk-...

ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=sk-ant-...

# Max output tokens per LLM call (includes reasoning/thinking tokens on models that use them).
LLM_MAX_TOKENS=8192
# Per-request timeout in seconds (the SDK retries twice on transient errors).
LLM_TIMEOUT_SECONDS=90
# Max tool-calling rounds in the research loop before the rules run anyway.
MAX_RESEARCH_STEPS=4

# ---------------------------------------------------------------------------------------------
# Persistence: tickets, audit trail and LangGraph checkpoints share one database
# ---------------------------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/support_agent.db
# Postgres (install with `uv sync --extra postgres`):
# DATABASE_URL=postgresql+psycopg://support:support@localhost:5432/support

# ---------------------------------------------------------------------------------------------
# Store API (orders, customers, knowledge base, escalations)
# ---------------------------------------------------------------------------------------------
# Empty = bundled mock Store API, called in-process over HTTP (ASGI transport).
# Set to a base URL to call a separately deployed Store API with the same contract.
STORE_API_URL=
STORE_API_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------------------------
# Business rules (see README > Business rules)
# ---------------------------------------------------------------------------------------------
# Refunds are allowed up to and including this many days after delivery.
POLICY_REFUND_WINDOW_DAYS=30
# Refunds up to and including this amount are executed without a human.
POLICY_AUTO_APPROVE_REFUND_LIMIT=100.00
# Refunds for VIP customers always go to a human.
POLICY_VIP_REFUNDS_REQUIRE_APPROVAL=true
# Refund requests written in an angry/hostile tone go to a human.
POLICY_NEGATIVE_SENTIMENT_REQUIRES_APPROVAL=true
# Refunds/address changes from a sender the helpdesk could not verify go to a human.
POLICY_UNVERIFIED_SENDER_REQUIRES_APPROVAL=true
# Complaints with negative sentiment or high urgency are escalated to the human queue.
POLICY_ESCALATE_NEGATIVE_COMPLAINTS=true
# Minimum knowledge-base relevance score to answer a question automatically (else escalate).
POLICY_KB_MIN_SCORE=0.15

# ---------------------------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------------------------
# Name used in prompts and reply signatures.
STORE_NAME=Brewline Coffee
# Folder with demo tickets (used by the CLI and the UI example picker).
EXAMPLES_DIR=examples
LOG_LEVEL=INFO
# console (human-readable) or json (one JSON object per line, for log aggregation)
LOG_FORMAT=console
